# Pinned inputs of the Jetpacs Emacs engine. Every script sources this file.
# Change ENGINE_BUILD whenever anything here, in deps/, or in tools/ changes
# without an Emacs version bump; the Companion pins "EMACS_VERSION+ENGINE_BUILD".
EMACS_VERSION=31.1
EMACS_TARBALL=emacs-31.1.tar.xz
EMACS_TARBALL_URL=https://ftp.gnu.org/gnu/emacs/emacs-31.1.tar.xz
EMACS_TARBALL_SHA256=1da5790d9580c81932b5bf700633114468da7b3412d69faa767daebf974f4586
# Release signing key of the Emacs 31.1 tarball (Sean Whitton), verified
# through the GNU keyring (https://ftp.gnu.org/gnu/gnu-keyring.gpg).
EMACS_SIGNING_KEY=9B917007AE030E36E4FC248B695B7AE4BF066240
ENGINE_BUILD=3
# Asset trimming for a display-less engine (docs/PLAN-bundled-emacs.md, E6):
# a space-separated list of top-level assets/ entries the harvest drops
# before it rebuilds the directory-tree index. `info` is the Info manuals,
# which nothing in a headless engine reads.
ENGINE_TRIM_ASSETS="info"
# Minimum Android API of the native code; the Companion's minSdk is 34.
ANDROID_API=34
ANDROID_NDK_VERSION=27.2.12479018
ANDROID_PLATFORM=android-37.0
ANDROID_BUILD_TOOLS=37.0.0
ENGINE_ABIS="arm64-v8a x86_64"
# The nested Android configure takes its C flags from ANDROID_CFLAGS and adds
# a bare -O only when no -O flag is present (configure.ac, "whether $CC
# accepts -O"); without this the engine would be built at -O1.
ENGINE_ANDROID_CFLAGS="-O2"
# 16 KB page alignment for every program Emacs's build links. The nested
# Android configure adds this flag to its own LDFLAGS after the NDK probe,
# but exec/configure (the SELinux exec loader: libexec1.so, libloader.so) is
# invoked with CC/LD/AS/AR/CFLAGS only and reads LDFLAGS and LOADERFLAGS from
# the environment, so both are exported around configure (tools/build-abi.sh).
ENGINE_LDFLAGS="-Wl,-z,max-page-size=16384"
# TLS (package archives and url.el over https). Emacs's own java/INSTALL,
# section GNUTLS, names ndk-build ports of GnuTLS and its dependencies,
# published by the Android port's maintainer as android-ports-for-gnu-emacs
# on SourceForge. tools/fetch-deps.sh downloads them; build-abi.sh extracts
# each, unmodified, beside the Emacs tree and names it in --with-ndk-path.
# gmp is 6.3.0, published with gnutls 3.8.5 (java/INSTALL still names
# 6.2.1). The SHA-256 pins were taken at the first download (2026-10-27);
# SourceForge's published MD5 matched for all but nettle, whose entry is
# past the reach of its project feed.
ENGINE_PORTS_URL=https://sourceforge.net/projects/android-ports-for-gnu-emacs/files
ENGINE_TLS_PORTS="gmp-6.3.0-emacs.tar.gz=777b6fd2d13f8095b13fc009966a6cb1fc54c331ad0a9fe412dd9a3c489b7b01
nettle-3.8-emacs.tar.gz=c133d7258b9dba72e67741a10671bce9b594f59faaaaf49d0cc723743be9f287
libtasn1-4.19.0-emacs.tar.gz=0ac458d79b9dcdbef0610f79d04cb9d0af5bbbaa3f60f81f1de62c632e38e8e7
p11-kit-0.24.1-emacs.tar.gz=8b7c2c7eba62e7b6303e0127ec6d25d812c2e068d4c6743ba2a0cb85a70f1040
gnutls-3.8.5-emacs.tar.gz=2878db72c3ce12edd3090f9c9abeccd113445e610d25673263ca084a3b1dcd28"
# No debuggable package (d8 --release); GnuTLS from the ports above, which
# configure must find (no `ifavailable': a missing port fails the build);
# SQLite from deps/sqlite for ebp.el's receipts store.
ENGINE_CONFIGURE_EXTRA="--without-android-debug --with-gnutls"
